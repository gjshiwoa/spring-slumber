# Chun Mian (Spring Sleep) shaderpack - English texts for the in-game option screens.
# Key format: option.<NAME>, option.<NAME>.comment (tooltip), value.<NAME>.<token>, screen.<SCREEN>.
# Option sources and value lists live in lib/common/globals/constants.glsl; screen layout in shaders.properties.

screen.SHADOWS=Lighting & Shadows
screen.ATMOSPHERE=Sky & Atmosphere
screen.WATER=Water
screen.POST=Post Processing & AA
screen.WORLD=World Effects

# ---- Lighting & Shadows ----
option.shadowMapResolution=Shadow Map Resolution
option.shadowMapResolution.comment=Shadow map resolution. Higher is sharper but slower; 2048 is the tuned default.
value.shadowMapResolution.1024=1024 (fast)
value.shadowMapResolution.2048=2048 (default)
value.shadowMapResolution.4096=4096 (sharp)
option.shadowDistance=Shadow Distance
option.shadowDistance.comment=Radius in blocks covered by shadow-map shadows. Beyond it, screen-space tracing takes over.
value.shadowDistance.64.0=64 (fast)
value.shadowDistance.96.0=96
value.shadowDistance.128.0=128 (default)
value.shadowDistance.192.0=192
value.shadowDistance.256.0=256
option.sunPathRotation=Sun Path Tilt
option.sunPathRotation.comment=Sun path tilt in degrees. Keep it non-zero, otherwise noon shadows vanish at the zenith.
option.ambientOcclusionLevel=Smooth Lighting AO
option.ambientOcclusionLevel.comment=Strength of the vanilla smooth-lighting ambient occlusion baked into block colors.
value.ambientOcclusionLevel.0.0=Off
value.ambientOcclusionLevel.0.5=Subtle
value.ambientOcclusionLevel.1.0=Vanilla
option.SHADOW_SCREEN_SPACE=Screen-Space Shadows
option.SHADOW_SCREEN_SPACE.comment=Ray-traced contact shadows up close and shadow coverage beyond the shadow map range. Small performance cost.
option.SHADOW_SS_STRENGTH=Screen-Space Shadow Strength
option.SHADOW_SS_STRENGTH.comment=Opacity of contact and long-range screen-space shadows.
value.SHADOW_SS_STRENGTH.0.5=Soft
value.SHADOW_SS_STRENGTH.0.75=Medium
value.SHADOW_SS_STRENGTH.1.0=Full
option.DIRECT_SPECULAR=Sun Specular Highlights
option.DIRECT_SPECULAR.comment=Analytic sun/moon specular on terrain. Plain resource packs get a subtle sheen; labPBR packs get real highlights.
option.DIRECT_SPECULAR_STRENGTH=Sun Specular Strength
option.DIRECT_SPECULAR_STRENGTH.comment=Brightness multiplier for sun specular highlights.
value.DIRECT_SPECULAR_STRENGTH.0.5=Subtle
value.DIRECT_SPECULAR_STRENGTH.1.0=Default
value.DIRECT_SPECULAR_STRENGTH.1.5=Strong
option.VEGETATION_SSS_STRENGTH=Leaf Translucency (SSS)
option.VEGETATION_SSS_STRENGTH.comment=Subsurface scattering through leaves and grass - how far light wraps onto the shaded side of plants.
value.VEGETATION_SSS_STRENGTH.0.0=Off
value.VEGETATION_SSS_STRENGTH.0.25=Faint
value.VEGETATION_SSS_STRENGTH.0.5=Default
value.VEGETATION_SSS_STRENGTH.0.75=Strong
value.VEGETATION_SSS_STRENGTH.1.0=Maximum

# ---- Sky & Atmosphere ----
option.CLOUDS_2D=Clouds
option.CLOUDS_2D.comment=Analytic 2D cloud layer. Disabling removes clouds from the sky and from water reflections.
option.CLOUDS_2D_COVERAGE=Cloud Coverage
option.CLOUDS_2D_COVERAGE.comment=How much of the sky is covered by clouds. Rain always pushes towards overcast.
value.CLOUDS_2D_COVERAGE.0.35=Rare
value.CLOUDS_2D_COVERAGE.0.45=Scattered
value.CLOUDS_2D_COVERAGE.0.55=Default
value.CLOUDS_2D_COVERAGE.0.65=Broken
value.CLOUDS_2D_COVERAGE.0.75=Nearly overcast
option.CLOUDS_2D_BRIGHTNESS=Cloud Brightness
option.CLOUDS_2D_BRIGHTNESS.comment=Brightness multiplier of the cloud layer.
option.SUN_DISK_RADIUS=Sun Size
option.SUN_DISK_RADIUS.comment=Visual radius of the sun disk. The default is already about 4x the real sun.
value.SUN_DISK_RADIUS.0.0094=Small
value.SUN_DISK_RADIUS.0.0141=Smaller
value.SUN_DISK_RADIUS.0.0188=Default
value.SUN_DISK_RADIUS.0.0282=Large
option.SUN_DISK_BRIGHTNESS=Sun Brightness
option.SUN_DISK_BRIGHTNESS.comment=Brightness of the sun disk and its glow. Scene sunlight itself stays unchanged.
option.MOON_DISK=Moon Disk
option.MOON_DISK.comment=Draw the analytic full-moon disk. Scene moonlight stays unchanged when disabled.
option.MOON_DISK_BRIGHTNESS=Moon Brightness
option.MOON_DISK_BRIGHTNESS.comment=Brightness of the moon disk. Scene moonlight itself stays unchanged.
option.STARS=Stars
option.STARS.comment=Procedural star field, fixed to the moon and fading in after dusk. Not drawn in water reflections (by design).
option.STARS_BRIGHTNESS=Star Brightness
option.STARS_BRIGHTNESS.comment=Brightness of individual stars.
option.STARS_DENSITY=Star Density
option.STARS_DENSITY.comment=How many stars the night sky shows.
value.STARS_DENSITY.0.08=Sparse
value.STARS_DENSITY.0.15=Default
value.STARS_DENSITY.0.3=Dense
option.AERIAL_PERSPECTIVE=Aerial Perspective Haze
option.AERIAL_PERSPECTIVE.comment=Physically based distance haze with direction, daylight color and rain response. Applies from mid range onward.
option.AERIAL_DIST_SCALE=Aerial Haze Strength
option.AERIAL_DIST_SCALE.comment=Strength of the aerial haze. Each step roughly doubles it; the default is tuned to stay subtle.
value.AERIAL_DIST_SCALE.3.556=Faint
value.AERIAL_DIST_SCALE.7.111111=Default
value.AERIAL_DIST_SCALE.14.222=Strong
value.AERIAL_DIST_SCALE.28.444=Heavy
option.BOUNDARY_FOG=Horizon Blend Fog
option.BOUNDARY_FOG.comment=Fog that dissolves distant terrain and sky into the horizon color at the render-distance edge. Recommended to keep enabled.

# ---- Water ----
option.WAVE_HEIGHT=Wave Height
option.WAVE_HEIGHT.comment=Wave amplitude. Drives wave normals, refraction shimmer and parallax.
value.WAVE_HEIGHT.0.1=Calm
value.WAVE_HEIGHT.0.2=Default
value.WAVE_HEIGHT.0.4=High
value.WAVE_HEIGHT.0.6=Stormy
option.WAVE_ROUGHNESS_MASK=Wave Roughness Variation
option.WAVE_ROUGHNESS_MASK.comment=Slowly varying patches of smoother and rougher waves. Not reflection blur; adds two texture fetches per water pixel.
option.WAVE_GRAZE_FADE=Grazing Flatten
option.WAVE_GRAZE_FADE.comment=Flattens waves toward grazing view angles to calm far-water shimmer. Looking straight down keeps full waves.
option.WAVE_GRAZE_STRENGTH=Grazing Flatten Strength
option.WAVE_GRAZE_STRENGTH.comment=How strongly waves flatten toward grazing angles. Lower keeps more roughness on distant water.
value.WAVE_GRAZE_STRENGTH.0.25=Subtle
value.WAVE_GRAZE_STRENGTH.0.5=Moderate
value.WAVE_GRAZE_STRENGTH.0.75=Strong
value.WAVE_GRAZE_STRENGTH.1.0=Full
option.WAVE_PARALLAX=Wave Parallax
option.WAVE_PARALLAX.comment=Shifts the shaded surface onto the wave height field for extra depth. Small performance cost.
option.WATER_REFRACTION_STRENGTH=Refraction Strength
option.WATER_REFRACTION_STRENGTH.comment=How strongly wave normals displace the view through the water surface.
value.WATER_REFRACTION_STRENGTH.0.2=Subtle
value.WATER_REFRACTION_STRENGTH.0.4=Moderate
value.WATER_REFRACTION_STRENGTH.0.6=Default
value.WATER_REFRACTION_STRENGTH.1.0=Strong
option.WATER_GLINT_BRIGHTNESS=Sun Glitter
option.WATER_GLINT_BRIGHTNESS.comment=Brightness of sun and moon sparkle on wave facets.
value.WATER_GLINT_BRIGHTNESS.0.5=Subtle
value.WATER_GLINT_BRIGHTNESS.1.0=Default
value.WATER_GLINT_BRIGHTNESS.2.0=Bright
option.WATER_FOG=Water Fog & Absorption
option.WATER_FOG.comment=Colored absorption through water seen from above plus underwater fog. Disabling gives clear water.
option.WATER_UW_VISIBILITY=Underwater Visibility
option.WATER_UW_VISIBILITY.comment=How far you can see underwater, in blocks.
value.WATER_UW_VISIBILITY.32.0=Murky
value.WATER_UW_VISIBILITY.48.0=Low
value.WATER_UW_VISIBILITY.64.0=Default
value.WATER_UW_VISIBILITY.96.0=Clear
value.WATER_UW_VISIBILITY.128.0=Very clear
option.WATER_CAUSTICS=Water Caustics
option.WATER_CAUSTICS.comment=Refracted light patterns the water surface casts onto the ground. Fades with depth when you are underwater.
option.WATER_CAUSTICS_BOOST=Caustics Strength
option.WATER_CAUSTICS_BOOST.comment=Intensity of the underwater caustic highlights.
value.WATER_CAUSTICS_BOOST.1.5=Soft
value.WATER_CAUSTICS_BOOST.2.0=Default
value.WATER_CAUSTICS_BOOST.2.8=Strong
value.WATER_CAUSTICS_BOOST.3.6=Intense
option.WET_SURFACE=Wet Ground Reflections
option.WET_SURFACE.comment=Rain puddle sheen: exposed ground gets flattened normals and screen-space reflections while it rains. Costs some performance.

# ---- Post Processing & AA ----
option.TAAU=Temporal Upscaling (TAAU)
option.TAAU.comment=Render at reduced resolution and reconstruct with built-in temporal upscaling. Disabling uses native resolution unless SR mod is actively upscaling; SR then owns reconstruction and render scale.
option.RENDER_SCALE=Render Scale
option.RENDER_SCALE.comment=Built-in TAAU render scale; 0.7 uses about 49% of full-resolution pixels. Overridden while SR mod is actively upscaling: change the quality/render scale in SR mod instead.
value.RENDER_SCALE.0.5=50% (fastest)
value.RENDER_SCALE.0.6=60%
value.RENDER_SCALE.0.7=70% (default)
value.RENDER_SCALE.0.8=80%
value.RENDER_SCALE.0.9=90%
value.RENDER_SCALE.1.0=100%
option.RCAS=Image Sharpening (RCAS)
option.RCAS.comment=FSR1-style adaptive sharpening that restores crispness lost to TAA. Very cheap.
option.RCAS_SHARPNESS=Sharpening Amount
option.RCAS_SHARPNESS.comment=0 is sharpest; every +1 halves the sharpening gain.
value.RCAS_SHARPNESS.0.0=Maximum
value.RCAS_SHARPNESS.0.5=Sharper (Default)
value.RCAS_SHARPNESS.1.0=Balanced
value.RCAS_SHARPNESS.1.5=Softer
value.RCAS_SHARPNESS.2.0=Gentle
option.RCAS_DENOISE=Sharpening Denoise
option.RCAS_DENOISE.comment=Suppresses sharpening over noisy areas so grain is not amplified.
option.BLOOM_STRENGTH=Bloom
option.BLOOM_STRENGTH.comment=HDR bloom intensity, added before tonemapping.
value.BLOOM_STRENGTH.0.0=Off
value.BLOOM_STRENGTH.0.04=Subtle
value.BLOOM_STRENGTH.0.075=Default
value.BLOOM_STRENGTH.0.12=Strong
value.BLOOM_STRENGTH.0.18=Heavy
option.AUTO_EXPOSURE_BASE_LUMINANCE=Night Brightness
option.AUTO_EXPOSURE_BASE_LUMINANCE.comment=Auto-exposure floor. Larger values darken nights, smaller values brighten them; daytime is unaffected.
value.AUTO_EXPOSURE_BASE_LUMINANCE.0.005=Brighter nights
value.AUTO_EXPOSURE_BASE_LUMINANCE.0.01=Default
value.AUTO_EXPOSURE_BASE_LUMINANCE.0.02=Darker nights
value.AUTO_EXPOSURE_BASE_LUMINANCE.0.04=Darkest nights
option.TONEMAP=Tonemap Operator
option.TONEMAP.comment=Overall tone response of the image. AgX is the soft default look; Filmic, ACES and Hable are ported from the ChunLei shaderpack.
value.TONEMAP.0=AgX (Default)
value.TONEMAP.1=Filmic
value.TONEMAP.2=ACES
value.TONEMAP.3=Hable
option.COLOR_BRIGHTNESS=Brightness
option.COLOR_BRIGHTNESS.comment=Simple color filter applied before tonemapping. 1.0 leaves the image unchanged.
value.COLOR_BRIGHTNESS.0.6=Much Darker
value.COLOR_BRIGHTNESS.0.8=Darker
value.COLOR_BRIGHTNESS.0.9=Slightly Darker
value.COLOR_BRIGHTNESS.1.0=Default
value.COLOR_BRIGHTNESS.1.1=Slightly Brighter
value.COLOR_BRIGHTNESS.1.2=Brighter
value.COLOR_BRIGHTNESS.1.4=Much Brighter
option.COLOR_CONTRAST=Contrast
option.COLOR_CONTRAST.comment=Simple color filter applied before tonemapping, pivoted at middle gray. 1.0 leaves the image unchanged.
value.COLOR_CONTRAST.0.6=Very Flat
value.COLOR_CONTRAST.0.8=Flat
value.COLOR_CONTRAST.0.9=Slightly Flat
value.COLOR_CONTRAST.1.0=Default
value.COLOR_CONTRAST.1.1=Slightly Strong
value.COLOR_CONTRAST.1.2=Strong
value.COLOR_CONTRAST.1.4=Very Strong
option.COLOR_SATURATION=Saturation
option.COLOR_SATURATION.comment=Simple color filter applied before tonemapping. 0.0 is black and white; 1.0 leaves the image unchanged.
value.COLOR_SATURATION.0.0=Black & White
value.COLOR_SATURATION.0.4=Very Muted
value.COLOR_SATURATION.0.6=Muted
value.COLOR_SATURATION.0.8=Slightly Muted
value.COLOR_SATURATION.1.0=Default
value.COLOR_SATURATION.1.2=Slightly Vivid
value.COLOR_SATURATION.1.4=Vivid
value.COLOR_SATURATION.1.6=Very Vivid

# ---- World Effects ----
option.WAVING_PLANTS=Waving Plants
option.WAVING_PLANTS.comment=Wind animation for grass, crops, tall plants and leaves. Shadow-map geometry follows the same motion.
option.WAVING_SHORT_AMPLITUDE=Grass & Crops Sway
option.WAVING_SHORT_AMPLITUDE.comment=Sway amplitude for short grass, flowers and crops.
value.WAVING_SHORT_AMPLITUDE.0.5=Calm
value.WAVING_SHORT_AMPLITUDE.1.0=Default
value.WAVING_SHORT_AMPLITUDE.1.5=Breezy
value.WAVING_SHORT_AMPLITUDE.2.0=Windy
option.WAVING_TALL_AMPLITUDE=Tall Plant Sway
option.WAVING_TALL_AMPLITUDE.comment=Sway amplitude for tall grass and large flowers.
value.WAVING_TALL_AMPLITUDE.0.2=Calm
value.WAVING_TALL_AMPLITUDE.0.4=Default
value.WAVING_TALL_AMPLITUDE.0.8=Breezy
value.WAVING_TALL_AMPLITUDE.1.2=Windy
option.WAVING_LEAVES_AMPLITUDE=Leaf Sway
option.WAVING_LEAVES_AMPLITUDE.comment=Sway amplitude for leaves and vines (includes some vertical motion).
value.WAVING_LEAVES_AMPLITUDE.0.2=Calm
value.WAVING_LEAVES_AMPLITUDE.0.4=Default
value.WAVING_LEAVES_AMPLITUDE.0.8=Breezy
value.WAVING_LEAVES_AMPLITUDE.1.2=Windy
