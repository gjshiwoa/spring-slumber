# 「春眠」光影包 - 游戏内设置界面中文文本。
# 键格式：option.<名称>、option.<名称>.comment（悬浮提示）、value.<名称>.<档位值>、screen.<屏幕名>。
# 选项来源与值表在 lib/common/globals/constants.glsl，屏幕布局在 shaders.properties。

screen.SHADOWS=光照与阴影
screen.ATMOSPHERE=天空与大气
screen.WATER=水面
screen.POST=画质与后期
screen.WORLD=世界效果

# ---- 光照与阴影 ----
option.shadowMapResolution=阴影分辨率
option.shadowMapResolution.comment=阴影贴图分辨率，越高越清晰也越吃性能；2048 为调校默认档。
value.shadowMapResolution.1024=1024（流畅）
value.shadowMapResolution.2048=2048（默认）
value.shadowMapResolution.4096=4096（精细）
option.shadowDistance=阴影距离
option.shadowDistance.comment=阴影贴图覆盖半径（格）。超出后远景阴影由屏幕空间追踪接管。
value.shadowDistance.64.0=64（流畅）
value.shadowDistance.96.0=96
value.shadowDistance.128.0=128（默认）
value.shadowDistance.192.0=192
value.shadowDistance.256.0=256
option.sunPathRotation=太阳轨迹倾角
option.sunPathRotation.comment=太阳运行轨迹的倾斜角度（度）。保持非零，否则正午太阳直射头顶、影子会退化消失。
option.ambientOcclusionLevel=平滑光照阴影
option.ambientOcclusionLevel.comment=原版平滑光照的环境光遮蔽强度（烙进方块顶点色的暗角）。
value.ambientOcclusionLevel.0.0=关闭
value.ambientOcclusionLevel.0.5=减弱
value.ambientOcclusionLevel.1.0=原版
option.SHADOW_SCREEN_SPACE=屏幕空间阴影
option.SHADOW_SCREEN_SPACE.comment=近处接触阴影与阴影贴图范围外的远景阴影接管。有少量性能开销。
option.SHADOW_SS_STRENGTH=屏幕空间阴影强度
option.SHADOW_SS_STRENGTH.comment=接触影与远景接管影的浓淡。
value.SHADOW_SS_STRENGTH.0.5=偏淡
value.SHADOW_SS_STRENGTH.0.75=中等
value.SHADOW_SS_STRENGTH.1.0=默认
option.DIRECT_SPECULAR=阳光镜面高光
option.DIRECT_SPECULAR.comment=地形表面的日 / 月解析镜面高光。普通材质有轻微光泽，labPBR 材质的光滑面会出现真实的太阳耀斑。
option.DIRECT_SPECULAR_STRENGTH=高光强度
option.DIRECT_SPECULAR_STRENGTH.comment=阳光镜面高光的亮度倍率。
value.DIRECT_SPECULAR_STRENGTH.0.5=偏弱
value.DIRECT_SPECULAR_STRENGTH.1.0=默认
value.DIRECT_SPECULAR_STRENGTH.1.5=增强
option.VEGETATION_SSS_STRENGTH=植被透光（SSS）
option.VEGETATION_SSS_STRENGTH.comment=叶片与草的次表面散射——光向植物背光面渗开的程度。
value.VEGETATION_SSS_STRENGTH.0.0=关闭
value.VEGETATION_SSS_STRENGTH.0.25=轻微
value.VEGETATION_SSS_STRENGTH.0.5=默认
value.VEGETATION_SSS_STRENGTH.0.75=增强
value.VEGETATION_SSS_STRENGTH.1.0=全档

# ---- 天空与大气 ----
option.CLOUDS_2D=云层
option.CLOUDS_2D.comment=解析式 2D 平面云。关闭后天空与水面反射中的云一并移除。
option.CLOUDS_2D_COVERAGE=云量
option.CLOUDS_2D_COVERAGE.comment=天空被云覆盖的比例。雨天总会自动推向阴天。
value.CLOUDS_2D_COVERAGE.0.35=稀少
value.CLOUDS_2D_COVERAGE.0.45=较少
value.CLOUDS_2D_COVERAGE.0.55=默认
value.CLOUDS_2D_COVERAGE.0.65=较多
value.CLOUDS_2D_COVERAGE.0.75=接近阴天
option.CLOUDS_2D_BRIGHTNESS=云亮度
option.CLOUDS_2D_BRIGHTNESS.comment=云层整体亮度倍率。
option.SUN_DISK_RADIUS=太阳大小
option.SUN_DISK_RADIUS.comment=太阳圆盘的视觉半径。默认档约为真实太阳的 4 倍大。
value.SUN_DISK_RADIUS.0.0094=小
value.SUN_DISK_RADIUS.0.0141=较小
value.SUN_DISK_RADIUS.0.0188=默认
value.SUN_DISK_RADIUS.0.0282=大
option.SUN_DISK_BRIGHTNESS=太阳亮度
option.SUN_DISK_BRIGHTNESS.comment=太阳圆盘及其辉光的亮度。场景阳光本身不受影响。
option.MOON_DISK=月亮
option.MOON_DISK.comment=解析满月圆盘。关闭后场景月光不变、只是看不见月亮。
option.MOON_DISK_BRIGHTNESS=月亮亮度
option.MOON_DISK_BRIGHTNESS.comment=月亮圆盘的亮度。场景月光本身不受影响。
option.STARS=星空
option.STARS.comment=程序化星点，星图与月亮固连、暮光后渐显。按设计不绘制进水面反射。
option.STARS_BRIGHTNESS=星星亮度
option.STARS_BRIGHTNESS.comment=单个星点的亮度。
option.STARS_DENSITY=星星密度
option.STARS_DENSITY.comment=夜空中星星的数量。
value.STARS_DENSITY.0.08=稀疏
value.STARS_DENSITY.0.15=默认
value.STARS_DENSITY.0.3=繁密
option.AERIAL_PERSPECTIVE=大气透视雾
option.AERIAL_PERSPECTIVE.comment=物理式空气透视：随方向、时刻与雨天变化的远景雾感，自中距离起生效。
option.AERIAL_DIST_SCALE=大气雾浓度
option.AERIAL_DIST_SCALE.comment=大气透视的强度。每档约翻倍，默认档调校为克制自然。
value.AERIAL_DIST_SCALE.3.556=淡
value.AERIAL_DIST_SCALE.7.111111=默认
value.AERIAL_DIST_SCALE.14.222=浓
value.AERIAL_DIST_SCALE.28.444=很浓
option.BOUNDARY_FOG=地平线融接雾
option.BOUNDARY_FOG.comment=在渲染视距边缘把远景与天空溶进地平线色的融接雾。建议保持开启。

# ---- 水面 ----
option.WAVE_HEIGHT=波浪高度
option.WAVE_HEIGHT.comment=波幅档位，驱动波面法线、折射晃动与视差。
value.WAVE_HEIGHT.0.1=微浪
value.WAVE_HEIGHT.0.2=默认
value.WAVE_HEIGHT.0.4=大浪
value.WAVE_HEIGHT.0.6=巨浪
option.WAVE_ROUGHNESS_MASK=水波粗糙变化
option.WAVE_ROUGHNESS_MASK.comment=恢复缓慢变化的低频波团，让水面各处在平滑与粗糙间变化。不是反射模糊；每水像素增加两次纹理采样。
option.WAVE_GRAZE_FADE=掠视平坦
option.WAVE_GRAZE_FADE.comment=平视远水（掠视）时逐渐压平波浪，平息远处水面的闪烁；俯视正对水面时保留完整波纹。
option.WAVE_GRAZE_STRENGTH=掠视平坦强度
option.WAVE_GRAZE_STRENGTH.comment=波浪随掠视角度压平的程度，调低可让远处水面保留更多波纹起伏。
value.WAVE_GRAZE_STRENGTH.0.25=轻微
value.WAVE_GRAZE_STRENGTH.0.5=中等
value.WAVE_GRAZE_STRENGTH.0.75=较强
value.WAVE_GRAZE_STRENGTH.1.0=完整
option.WAVE_PARALLAX=波浪视差
option.WAVE_PARALLAX.comment=把着色点沿视线贴合到波高场，让波浪更有立体起伏。有少量性能开销。
option.WATER_REFRACTION_STRENGTH=折射强度
option.WATER_REFRACTION_STRENGTH.comment=波面法线扰动透过水面所见景物的程度。
value.WATER_REFRACTION_STRENGTH.0.2=偏弱
value.WATER_REFRACTION_STRENGTH.0.4=中等
value.WATER_REFRACTION_STRENGTH.0.6=默认
value.WATER_REFRACTION_STRENGTH.1.0=强
option.WATER_GLINT_BRIGHTNESS=波光亮度
option.WATER_GLINT_BRIGHTNESS.comment=日 / 月在波面上的粼光亮度。
value.WATER_GLINT_BRIGHTNESS.0.5=偏弱
value.WATER_GLINT_BRIGHTNESS.1.0=默认
value.WATER_GLINT_BRIGHTNESS.2.0=明亮
option.WATER_FOG=水雾与吸收
option.WATER_FOG.comment=水上透过水面的彩色吸收雾与水下雾。关闭后为清澈见底的「纯水」。
option.WATER_UW_VISIBILITY=水下能见度
option.WATER_UW_VISIBILITY.comment=水下可视距离（格）。
value.WATER_UW_VISIBILITY.32.0=浑浊
value.WATER_UW_VISIBILITY.48.0=偏低
value.WATER_UW_VISIBILITY.64.0=默认
value.WATER_UW_VISIBILITY.96.0=清澈
value.WATER_UW_VISIBILITY.128.0=极清
option.WATER_CAUSTICS=水下焦散
option.WATER_CAUSTICS.comment=水面折射在地面投出的光网。人在水下时随水深自动变浅。
option.WATER_CAUSTICS_BOOST=焦散强度
option.WATER_CAUSTICS_BOOST.comment=水下焦散亮网的强度。
value.WATER_CAUSTICS_BOOST.1.5=柔和
value.WATER_CAUSTICS_BOOST.2.0=默认
value.WATER_CAUSTICS_BOOST.2.8=较强
value.WATER_CAUSTICS_BOOST.3.6=强烈
option.WET_SURFACE=雨天湿滑反射
option.WET_SURFACE.comment=雨天积水反光：露天地面法线被压平并获得屏幕空间反射。有一定性能开销。

# ---- 画质与后期 ----
option.TAAU=时域超分辨率（TAAU）
option.TAAU.comment=以较低分辨率渲染、用内置时间累积重建画面。关闭后按原生分辨率渲染；但 SR mod 超分生效时仍由 SR 接管重建和渲染比例，不受此开关影响。
option.RENDER_SCALE=渲染比例
option.RENDER_SCALE.comment=内置 TAAU 的渲染比例，0.7 约为全分辨率的 49% 像素量。SR mod 超分生效时此值被覆盖，请在 SR mod 中调整质量档或渲染比例。
value.RENDER_SCALE.0.5=50%（最省）
value.RENDER_SCALE.0.6=60%
value.RENDER_SCALE.0.7=70%（默认）
value.RENDER_SCALE.0.8=80%
value.RENDER_SCALE.0.9=90%
value.RENDER_SCALE.1.0=100%
option.RCAS=画面锐化（RCAS）
option.RCAS.comment=FSR1 风格自适应锐化，找回 TAA 时间累积损失的清晰度。开销极小。
option.RCAS_SHARPNESS=锐化强度
option.RCAS_SHARPNESS.comment=0 最锐；每 +1 增益减半。
value.RCAS_SHARPNESS.0.0=最锐
value.RCAS_SHARPNESS.0.5=较锐（默认）
value.RCAS_SHARPNESS.1.0=均衡
value.RCAS_SHARPNESS.1.5=较柔
value.RCAS_SHARPNESS.2.0=柔和
option.RCAS_DENOISE=锐化降噪
option.RCAS_DENOISE.comment=在噪声明显的区域抑制锐化，避免放大颗粒感。
option.BLOOM_STRENGTH=泛光强度
option.BLOOM_STRENGTH.comment=HDR 泛光强度（tonemap 前线性域叠加）。
value.BLOOM_STRENGTH.0.0=关闭
value.BLOOM_STRENGTH.0.04=弱
value.BLOOM_STRENGTH.0.075=默认
value.BLOOM_STRENGTH.0.12=强
value.BLOOM_STRENGTH.0.18=很强
option.AUTO_EXPOSURE_BASE_LUMINANCE=夜晚亮度
option.AUTO_EXPOSURE_BASE_LUMINANCE.comment=自动曝光的亮度地板：调大夜晚更暗、调小夜晚更亮，白天不受影响。
value.AUTO_EXPOSURE_BASE_LUMINANCE.0.005=夜晚更亮
value.AUTO_EXPOSURE_BASE_LUMINANCE.0.01=默认
value.AUTO_EXPOSURE_BASE_LUMINANCE.0.02=夜晚更暗
value.AUTO_EXPOSURE_BASE_LUMINANCE.0.04=夜晚最暗
option.TONEMAP=色调映射
option.TONEMAP.comment=画面的整体色调响应。AgX 为默认的柔和风格；Filmic、ACES 与 Hable 移植自春雷光影。
value.TONEMAP.0=AgX（默认）
value.TONEMAP.1=Filmic
value.TONEMAP.2=ACES
value.TONEMAP.3=Hable
option.COLOR_BRIGHTNESS=亮度
option.COLOR_BRIGHTNESS.comment=tonemap 前线性域的简单色彩滤镜；1.0 为原始亮度。
value.COLOR_BRIGHTNESS.0.6=大幅调暗
value.COLOR_BRIGHTNESS.0.8=调暗
value.COLOR_BRIGHTNESS.0.9=略暗
value.COLOR_BRIGHTNESS.1.0=默认
value.COLOR_BRIGHTNESS.1.1=略亮
value.COLOR_BRIGHTNESS.1.2=调亮
value.COLOR_BRIGHTNESS.1.4=大幅调亮
option.COLOR_CONTRAST=对比度
option.COLOR_CONTRAST.comment=tonemap 前线性域的简单色彩滤镜（绕中灰枢轴）；1.0 为原始对比度。
value.COLOR_CONTRAST.0.6=很平淡
value.COLOR_CONTRAST.0.8=平淡
value.COLOR_CONTRAST.0.9=略平淡
value.COLOR_CONTRAST.1.0=默认
value.COLOR_CONTRAST.1.1=略强
value.COLOR_CONTRAST.1.2=强
value.COLOR_CONTRAST.1.4=很强
option.COLOR_SATURATION=饱和度
option.COLOR_SATURATION.comment=tonemap 前线性域的简单色彩滤镜；0.0 为黑白，1.0 为原始饱和度。
value.COLOR_SATURATION.0.0=黑白
value.COLOR_SATURATION.0.4=很低
value.COLOR_SATURATION.0.6=低
value.COLOR_SATURATION.0.8=略低
value.COLOR_SATURATION.1.0=默认
value.COLOR_SATURATION.1.2=略高
value.COLOR_SATURATION.1.4=高
value.COLOR_SATURATION.1.6=很高

# ---- 世界效果 ----
option.WAVING_PLANTS=植物晃动
option.WAVING_PLANTS.comment=花草、农作物、高草与树叶的风场摆动，贴图阴影几何同步摆动。
option.WAVING_SHORT_AMPLITUDE=花草摆动幅度
option.WAVING_SHORT_AMPLITUDE.comment=矮草、花与农作物的摆动幅度。
value.WAVING_SHORT_AMPLITUDE.0.5=微风
value.WAVING_SHORT_AMPLITUDE.1.0=默认
value.WAVING_SHORT_AMPLITUDE.1.5=清风
value.WAVING_SHORT_AMPLITUDE.2.0=大风
option.WAVING_TALL_AMPLITUDE=高草摆动幅度
option.WAVING_TALL_AMPLITUDE.comment=双高植物（高草、大花）的摆动幅度。
value.WAVING_TALL_AMPLITUDE.0.2=微风
value.WAVING_TALL_AMPLITUDE.0.4=默认
value.WAVING_TALL_AMPLITUDE.0.8=清风
value.WAVING_TALL_AMPLITUDE.1.2=大风
option.WAVING_LEAVES_AMPLITUDE=树叶摆动幅度
option.WAVING_LEAVES_AMPLITUDE.comment=树叶与藤蔓的摆动幅度（含竖直分量）。
value.WAVING_LEAVES_AMPLITUDE.0.2=微风
value.WAVING_LEAVES_AMPLITUDE.0.4=默认
value.WAVING_LEAVES_AMPLITUDE.0.8=清风
value.WAVING_LEAVES_AMPLITUDE.1.2=大风
